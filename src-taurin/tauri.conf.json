{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sakura Launcher",
  "version": "0.5.0",
  "identifier": "com.sakura.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Sakura Launcher",
        "width": 1280,
        "height": 760,
        "minWidth": 1050,
        "minHeight": 680,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ]
  }
}